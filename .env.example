# MySQL (8.0+). Use DATABASE_URL, or the MYSQL_* variables below.
DATABASE_URL=mysql://user:password@localhost:3306/ksu_procurement
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=ksu_procurement
# Set to true for hosted MySQL providers that require TLS (Aiven, TiDB Cloud, etc.)
MYSQL_SSL=false
# Tables are created automatically on first request; set false to load database/schema.sql yourself.
MYSQL_AUTO_MIGRATE=true

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h

# App URL (used for password reset links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nodemailer (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mubarakadambako@gmail.com
SMTP_PASS=
SMTP_FROM="KSU Procurement <mubarakadambako@gmail.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Escalation threshold (Naira)
ESCALATION_THRESHOLD=10000000
